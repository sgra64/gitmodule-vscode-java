//- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// VSCode project settings file.
{
    // Java Code Runner settings
    "code-runner.defaultLanguage": "java",
    "code-runner.clearPreviousOutput": true,
    "code-runner.saveAllFilesBeforeRun": true,
    "code-runner.runInTerminal": true,  // avoid UTF-8 problem in OUTPUT console on Windows
    "code-runner.executorMap": {
        // 
        // "java": "[ ! -d target/resources ] && mkdir -p target/resources; cp -R src/resources target; java @.vscode/launch-coderunner",
        // "java": "javac Application.java Conditional.java && java Application",
        "java": ".vscode/code-runner.sh",
        // "java": "javac *.java && java Application",
        "vmArgs": "-Dfile.encoding=UTF-8"
    },

    // Java and debug settings
    // "java.autobuild.enabled": true,
    // "java.jdt.ls.vmargs": "-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8",
    // "files.encoding": "utf8",
    // "java.debug.settings.onBuildFailureProceed": true,
    // "java.debug.settings.showHex": true,
    // "java.debug.settings.vmArgs": "-Dfile.encoding=UTF-8",
    // "java.debug.settings.console": "integratedTerminal",

    // Terminal settings, see https://code.visualstudio.com/docs/terminal/profiles
    "terminal.integrated.defaultProfile.windows": "Bash",
    "terminal.integrated.profiles.windows": {
        "Bash": {
          "path": ["bash"],
          "args": ["--init-file", "'${workspaceFolder}'/.vscode/launch-terminal.sh"],
        //   "args": ["--init-file", "~/.profile"],
          "icon": "terminal-bash",
        }
    }
}
